# ==========================================
# OperaIA.lab — template de ambiente
# Copie para .env (dev) ou para
#   /opt/operaia-lab/shared/.env (produção)
# NUNCA commitir .env com valores reais.
# Documentação: docs/production/environment.md
# ==========================================

# --- Ambiente ---
# development | test | production
NODE_ENV=production

# --- API (em produção: bind localhost; Caddy na frente) ---
API_HOST=127.0.0.1
API_PORT=3333
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL) ---
# Em produção: preencher na VM; senha forte; sem expor 5432 publicamente.
POSTGRES_USER=operaia
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=operaia_lab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- LLM ---
# Provedor: gemini | openai | anthropic | openrouter | deterministic
# deterministic = apenas testes; produção usa provedor concreto.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
# CSV de fallbacks (opcional). Providers não implementados são ignorados.
# LLM_FALLBACK_PROVIDERS=openai,anthropic
LLM_MAX_TOKENS_CLAMP=8192
LLM_OBSERVABILITY=false

# --- Chaves LLM (deixar vazio no template; preencher só no .env real) ---
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Runtime contínuo (Equipe Digital) ---
CONTINUOUS_RUNTIME_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=5000
SCHEDULER_INTERVAL_MS=60000
MISSION_STALE_RUNNING_MS=900000

# --- Papel do processo (contrato futuro para units systemd separadas) ---
# Hoje o monorepo roda API+runtime+workers+scheduler num único processo.
# Valores reservados: all | api | runtime | worker | scheduler
OPERAIA_PROCESS_ROLE=all

# --- Web (build de produção do lab) ---
VITE_API_URL=https://api.operaia.com.br/api/v1

# --- Observabilidade / painel VPS (metadados) ---
VPS_NAME="OperaIA · Oracle Cloud"
VPS_PROVIDER=oracle
VPS_REGION=sa-saopaulo-1
VPS_MONTHLY_COST_BRL=0
VPS_COST_CURRENCY=BRL

# --- Paths de produção (layout /opt/operaia-lab) ---
OPERAIA_ROOT=/opt/operaia-lab
OPERAIA_CURRENT=/opt/operaia-lab/current
OPERAIA_SHARED=/opt/operaia-lab/shared
OPERAIA_LOG_DIR=/opt/operaia-lab/shared/logs
OPERAIA_RUNTIME_DIR=/opt/operaia-lab/shared/runtime

# --- Backup ---
BACKUP_DIR=/opt/operaia-lab/shared/backups
RETENTION_DAYS=14
