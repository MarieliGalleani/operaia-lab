# ==========================================
# OperaIA.lab - variaveis de ambiente
# Copie para .env e ajuste os valores.
# ==========================================

# Ambiente de execucao: development | test | production
NODE_ENV=development

# --- API ---
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL) ---
# Deve bater com o infra/docker-compose.yml
POSTGRES_USER=operaia
POSTGRES_PASSWORD=operaia
POSTGRES_DB=operaia_lab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- LLM (Equipe Digital) ---
# Provedor: gemini | openai | anthropic | openrouter | deterministic
# deterministic = apenas testes; produto usa gemini (ou outro concreto).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Fallbacks (CSV). Providers ainda nao implementados sao ignorados com warn.
# LLM_FALLBACK_PROVIDERS=openai,anthropic

# Observabilidade de chamadas LLM no console da API
LLM_OBSERVABILITY=true

# Clamp tecnico de maxTokens (LLM Policy Layer)
LLM_MAX_TOKENS_CLAMP=8192

# Reservado para provedores futuros
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
