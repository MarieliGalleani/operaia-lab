{
  "name": "operaia-lab",
  "version": "0.1.0",
  "private": true,
  "description": "OperaIA.lab - escritorio virtual inteligente baseado em agentes de IA",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @operaia/api dev",
    "dev:web": "pnpm --filter @operaia/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @operaia/database generate",
    "db:migrate": "pnpm --filter @operaia/database migrate",
    "db:seed": "pnpm --filter @operaia/database seed",
    "db:studio": "pnpm --filter @operaia/database studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.11.0"
}
