# TEMPLATE — NÃO instalar / NÃO enable / NÃO start nesta missão.
#
# RESERVADO para workers dedicados (split futuro).
# NÃO habilitar enquanto operaia-api rodar com OPERAIA_PROCESS_ROLE=all.
#
# Pré-requisito: app respeitar OPERAIA_PROCESS_ROLE=worker.

[Unit]
Description=OperaIA.lab Mission Workers (template futuro)
Documentation=file:/opt/operaia-lab/current/docs/production/architecture.md
After=network-online.target postgresql.service
Wants=network-online.target
RequiresMountsFor=/opt/operaia-lab
ConditionPathExists=/opt/operaia-lab/shared/flags/enable-process-split

[Service]
Type=simple
User=operaia
Group=operaia
WorkingDirectory=/opt/operaia-lab/current
Environment=NODE_ENV=production
Environment=OPERAIA_PROCESS_ROLE=worker
Environment=CONTINUOUS_RUNTIME_ENABLED=true
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/opt/operaia-lab/shared/.env
ExecStartPre=/usr/bin/test -f /opt/operaia-lab/shared/.env
ExecStart=/usr/bin/pnpm --filter @operaia/api start
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=operaia-worker

[Install]
WantedBy=multi-user.target
