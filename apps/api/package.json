{
  "name": "@operaia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ops:nexo": "tsx --env-file-if-exists=../../.env src/modules/operations/run-nexo-mission.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@operaia/agents": "workspace:*",
    "@operaia/ai-core": "workspace:*",
    "@operaia/cto-mag": "workspace:*",
    "@operaia/database": "workspace:*",
    "@operaia/employee-framework": "workspace:*",
    "@operaia/employee-runtime": "workspace:*",
    "@operaia/memory": "workspace:*",
    "@operaia/shared": "workspace:*",
    "@operaia/workspace-runtime": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^3.0.5"
  }
}
