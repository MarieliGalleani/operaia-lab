// OperaIA.lab - schema de dados do CORE operacional.
// Modular Monolith: um unico banco, modelos isolados por responsabilidade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MissionReadiness {
  BLOCKED
  READY
}

/// Objetivos organizacionais acima dos projetos (Workspace).
model OrganizationalGoal {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  priority    Priority   @default(MEDIUM)
  projects    Project[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, priority])
  @@map("organizational_goals")
}

/// Projetos gerenciados pelo escritorio virtual (NEXO, MenuFlow, etc.).
model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  goalId      String?
  goal        OrganizationalGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([goalId])
  @@map("projects")
}

/// Unidade de trabalho pertencente a um projeto, opcionalmente atribuida a um agente.
model Task {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)

  assignedAgentId String?
  assignedAgent   Agent?  @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("tasks")
}

/// Agentes de IA do escritorio virtual. O primeiro e o OperaIA CEO.
model Agent {
  id                 String   @id @default(uuid())
  name               String   @unique
  role               String
  description        String?
  systemInstructions String
  active             Boolean  @default(true)
  tasks              Task[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("agents")
}

/// Estados da fila operacional de missoes (Equipe Digital continua).
enum MissionStatus {
  CREATED
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

/// Tipo de missao na fila distribuida.
enum MissionKind {
  COORDINATE
  EXECUTE
  CONSOLIDATE
}

/// Missao persistente — fonte de verdade da fila (sobrevive a restart).
model Mission {
  id                     String           @id @default(uuid())
  workspaceId            String
  projectId              String?
  objective              String
  /// Hash curto workspaceId+objective para dedupe do scheduler.
  objectiveHash          String
  missionKind            MissionKind      @default(COORDINATE)
  priority               Priority         @default(MEDIUM)
  status                 MissionStatus    @default(CREATED)
  readiness              MissionReadiness @default(READY)
  ownerEmployeeId        String
  requiredSpecialization String?
  parentMissionId        String?
  progress               Int              @default(0)
  attempt                Int              @default(0)
  maxAttempts            Int              @default(3)
  scheduledAt            DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  lastError              String?
  resultJson             Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  events       MissionEvent[]
  dependsOn    MissionDependency[] @relation("MissionDependents")
  dependedBy   MissionDependency[] @relation("MissionDependencies")
  learning     MissionLearning?

  @@index([status, scheduledAt])
  @@index([ownerEmployeeId, status])
  @@index([requiredSpecialization, status])
  @@index([missionKind, status])
  @@index([workspaceId, objectiveHash, status])
  @@index([parentMissionId])
  @@index([readiness, status])
  @@map("missions")
}

/// DAG de dependencias entre missoes (EXECUTE → EXECUTE).
model MissionDependency {
  id                 String  @id @default(uuid())
  missionId          String
  dependsOnMissionId String
  mission            Mission @relation("MissionDependents", fields: [missionId], references: [id], onDelete: Cascade)
  dependsOn          Mission @relation("MissionDependencies", fields: [dependsOnMissionId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@unique([missionId, dependsOnMissionId])
  @@index([dependsOnMissionId])
  @@map("mission_dependencies")
}

/// Memoria organizacional reutilizavel apos cada missao.
model MissionLearning {
  id              String   @id @default(uuid())
  missionId       String   @unique
  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workspaceId     String
  projectId       String?
  context         String
  decision        String
  justification   String
  result          String
  impact          String?
  risksFound      Json?
  lessonsLearned  String
  reuseWhen       String?
  avoidWhen       String?
  durationMs      Int?
  metricsJson     Json?
  createdAt       DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId])
  @@map("mission_learnings")
}

/// Historico / logs estruturados por missao.
model MissionEvent {
  id        String   @id @default(uuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([missionId, createdAt])
  @@map("mission_events")
}

/// Indice recuperavel M1 (MemoryStore persistente).
/// Fonte de verdade continua em Mission / MissionLearning — esta tabela e derivada.
model OperationalMemoryNote {
  id              String    @id @default(uuid())
  workspaceId     String
  content         String
  /// Sempre "operational" em M1.
  layer           String    @default("operational")
  /// operational-run-summary | organizational-learning | operational-digest
  kind            String
  /// mission | learning | digest
  sourceType      String
  /// Id da entidade de origem (missionId / learningId / digest batch id)
  sourceId        String
  /// persistMissionMemory | recordMissionLearning | backfill-mission | backfill-learning
  origin          String
  missionId       String?
  learningId      String?
  statusFinal     String?
  objective       String?
  decision        String?
  resultSummary   String?
  risksJson       Json?
  nextActionsJson Json?
  metadataJson    Json?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  archivedAt      DateTime?

  @@unique([workspaceId, sourceType, sourceId, kind])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@index([workspaceId, expiresAt])
  @@index([missionId])
  @@map("operational_memory_notes")
}

/// Heartbeat + metricas por Employee worker logico.
model WorkerHeartbeat {
  employeeId       String   @id
  status           String
  currentMissionId String?
  metricsJson      Json?
  startedAt        DateTime
  lastSeenAt       DateTime
  updatedAt        DateTime @updatedAt

  @@map("worker_heartbeats")
}

/// Regras de verificacao recorrente (scheduler).
model ScheduleRule {
  id              String    @id @default(uuid())
  workspaceId     String?
  intervalSec     Int
  enabled         Boolean   @default(true)
  lastEnqueuedAt  DateTime?
  configJson      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
  @@map("schedule_rules")
}

enum ApprovalStatus {
  DRAFT
  PROPOSED
  WAITING_APPROVAL
  APPROVED
  REJECTED
  IMPLEMENTING
  COMPLETED
}

/// Lifecycle Domain Signal (ADR-009 / S1).
enum DomainSignalStatus {
  DETECTED
  EVALUATED
  CONVERTED
  RESOLVED
  IGNORED
  EXPIRED
}

/// Decisao de avaliacao auditavel. CONVERT_CANDIDATE nao enfileira Mission em S1.
enum DomainSignalEvaluationDecision {
  CONVERT_CANDIDATE
  IGNORE
  DEFER
}

/// Mapa origem externa → workspace (kill-switch + isolamento).
model WorkspaceSourceBinding {
  id          String   @id @default(uuid())
  workspaceId String
  /// github | n8n | http | internal | …
  sourceType  String
  /// ex.: owner/repo, workflowId
  externalRef String
  enabled     Boolean  @default(true)
  /// filtros (branches, labels) — sem secrets em claro
  configJson  Json?
  /// ponteiro a secret store (nunca o secret)
  secretRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals DomainSignal[]

  @@unique([workspaceId, sourceType, externalRef])
  @@index([sourceType, externalRef, enabled])
  @@map("workspace_source_bindings")
}

/// Ledger de ingress — Signal informa; Opera decide; Mission executa (ADR-009).
model DomainSignal {
  id          String  @id @default(uuid())
  workspaceId String
  bindingId   String?
  binding     WorkspaceSourceBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  /// Familia da origem (ADR source)
  sourceType String
  /// Id no sistema externo (ADR externalId)
  sourceId   String?
  /// Tipo tipado do evento — ex.: github.pr.opened
  type       String

  /// Idempotencia de entrega (unica unique de dedupe)
  deliveryId String
  /// Similaridade / agrupamento — NAO unique
  signalHash String

  /// Trace Signal → Evaluation → Mission → Learning
  correlationId String

  status DomainSignalStatus @default(DETECTED)

  /// Payload ja redigido
  payloadJson  Json
  metadataJson Json?

  evaluationDecision DomainSignalEvaluationDecision?
  /// nome/versao da politica (ex.: default-allowlist@1)
  evaluationPolicy   String?
  /// motivo estavel (ex.: policy_deny, unbound_source, ok)
  evaluationReason   String?
  /// detalhes estruturados da avaliacao
  evaluationJson     Json?
  evaluatedAt        DateTime?

  /// preenchido so em CONVERTED+ (S1: sem enqueue automatico)
  missionId String?

  payloadVersion Int @default(1)

  occurredAt  DateTime?
  receivedAt  DateTime  @default(now())
  convertedAt DateTime?
  resolvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sourceType, deliveryId])
  @@index([workspaceId, status, receivedAt])
  @@index([workspaceId, signalHash, receivedAt])
  @@index([correlationId])
  @@index([missionId])
  @@index([type, receivedAt])
  @@index([evaluationDecision, status])
  @@map("domain_signals")
}

/// Snapshot operacional de repositorio GitHub por workspace (scan do Supervisor).
model WorkspaceGithubSnapshot {
  id                     String   @id @default(uuid())
  workspaceId            String
  bindingId              String?
  repository             String
  defaultBranch          String
  lastCommitSha          String?
  primaryLanguage        String?
  openIssuesCount        Int      @default(0)
  openPullRequestsCount  Int      @default(0)
  /// updated_at / pushed_at remoto do GitHub
  remoteUpdatedAt        DateTime?
  scannedAt              DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([workspaceId, repository])
  @@index([workspaceId, scannedAt])
  @@map("workspace_github_snapshots")
}

/// Auditoria de acoes controladas (Action Runtime A.4).
enum ActionExecutionStatus {
  REQUESTED
  APPROVED
  RUNNING
  SUCCESS
  FAILED
  DENIED
}

model ActionExecution {
  id          String                @id @default(uuid())
  workspaceId String
  employeeId  String
  actionId    String
  target      String                @default("")
  status      ActionExecutionStatus @default(REQUESTED)
  requestedAt DateTime              @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  result      Json?
  error       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([workspaceId, requestedAt])
  @@index([employeeId, requestedAt])
  @@index([actionId, status])
  @@map("action_executions")
}

/// Propostas estruturais — aprovacao humana obrigatoria (sem apply automatico).
model ChangeProposal {
  id                   String         @id @default(uuid())
  projectId            String?
  title                String
  description          String
  justification        String
  evidenceJson         Json?
  expectedImpact       String
  affectedComponents   Json
  risksJson            Json?
  implementationPlan   String
  rollbackPlan         String
  diffRef              String?
  approvalStatus       ApprovalStatus @default(PROPOSED)
  approvedBy           String?
  approvedAt           DateTime?
  rejectedBy           String?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([approvalStatus, createdAt])
  @@index([projectId])
  @@map("change_proposals")
}
