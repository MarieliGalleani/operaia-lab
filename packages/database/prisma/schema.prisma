// OperaIA.lab - schema de dados do CORE operacional.
// Modular Monolith: um unico banco, modelos isolados por responsabilidade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MissionReadiness {
  BLOCKED
  READY
}

enum UserRole {
  ADMIN
}

/// Identidade humana autenticavel. Fase 0.1: apenas um ADMIN provisionado.
model User {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@map("users")
}

/// Sessao humana revogavel. Apenas o hash do token aleatorio e persistido.
model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Objetivos organizacionais acima dos projetos (Workspace).
model OrganizationalGoal {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  priority    Priority   @default(MEDIUM)
  projects    Project[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, priority])
  @@map("organizational_goals")
}

/// Projetos gerenciados pelo escritorio virtual (NEXO, MenuFlow, etc.).
model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  goalId      String?
  goal        OrganizationalGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([goalId])
  @@map("projects")
}

/// Unidade de trabalho pertencente a um projeto, opcionalmente atribuida a um agente.
model Task {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)

  assignedAgentId String?
  assignedAgent   Agent?  @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("tasks")
}

/// Agentes de IA do escritorio virtual. O primeiro e o OperaIA CEO.
model Agent {
  id                 String   @id @default(uuid())
  name               String   @unique
  role               String
  description        String?
  systemInstructions String
  active             Boolean  @default(true)
  tasks              Task[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("agents")
}

/// Estados da fila operacional de missoes (Equipe Digital continua).
enum MissionStatus {
  CREATED
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

/// Tipo de missao na fila distribuida.
enum MissionKind {
  COORDINATE
  EXECUTE
  CONSOLIDATE
}

/// Causa estrutural de criacao de uma Mission RAIZ (P1.2B). So a raiz
/// carrega origin — filhas (EXECUTE/CONSOLIDATE/follow-up) resolvem via
/// parentMissionId, nunca duplicam o campo. Nullable de proposito: nao
/// existe classificacao heuristica de missoes legadas (ver ADR/nota em
/// mission-origin.ts) — origin=NULL significa "legado nao classificado",
/// nunca "desenvolvimento" por padrao.
enum MissionOrigin {
  HUMAN_DEMAND
  HUMAN_ADVANCED
  CEO_SALA
  SCHEDULE_RULE
  SUPERVISOR_AUTO
  SIGNAL_GITHUB
}

/// Missao persistente — fonte de verdade da fila (sobrevive a restart).
model Mission {
  id                     String           @id @default(uuid())
  workspaceId            String
  projectId              String?
  objective              String
  /// Hash curto workspaceId+objective para dedupe do scheduler.
  objectiveHash          String
  missionKind            MissionKind      @default(COORDINATE)
  priority               Priority         @default(MEDIUM)
  status                 MissionStatus    @default(CREATED)
  readiness              MissionReadiness @default(READY)
  ownerEmployeeId        String
  requiredSpecialization String?
  /// Preenchido somente em missoes RAIZ (parentMissionId=null) pelo
  /// produtor que causou a criacao. Null em filhas e em missoes legadas.
  origin                 MissionOrigin?
  parentMissionId        String?
  progress               Int              @default(0)
  attempt                Int              @default(0)
  maxAttempts            Int              @default(3)
  /// Geracao do lease de execucao (claim/recover). Nao misturar com attempt.
  leaseVersion           Int              @default(0)
  scheduledAt            DateTime?
  startedAt              DateTime?
  finishedAt             DateTime?
  lastError              String?
  resultJson             Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  events       MissionEvent[]
  dependsOn    MissionDependency[] @relation("MissionDependents")
  dependedBy   MissionDependency[] @relation("MissionDependencies")
  learning     MissionLearning?

  @@index([status, scheduledAt])
  @@index([ownerEmployeeId, status])
  @@index([requiredSpecialization, status])
  @@index([missionKind, status])
  @@index([workspaceId, objectiveHash, status])
  @@index([parentMissionId])
  @@index([readiness, status])
  @@map("missions")
}

/// DAG de dependencias entre missoes (EXECUTE → EXECUTE).
model MissionDependency {
  id                 String  @id @default(uuid())
  missionId          String
  dependsOnMissionId String
  mission            Mission @relation("MissionDependents", fields: [missionId], references: [id], onDelete: Cascade)
  dependsOn          Mission @relation("MissionDependencies", fields: [dependsOnMissionId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@unique([missionId, dependsOnMissionId])
  @@index([dependsOnMissionId])
  @@map("mission_dependencies")
}

/// Memoria organizacional reutilizavel apos cada missao.
model MissionLearning {
  id              String   @id @default(uuid())
  missionId       String   @unique
  mission         Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workspaceId     String
  projectId       String?
  context         String
  decision        String
  justification   String
  result          String
  impact          String?
  risksFound      Json?
  lessonsLearned  String
  reuseWhen       String?
  avoidWhen       String?
  durationMs      Int?
  metricsJson     Json?
  createdAt       DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId])
  @@map("mission_learnings")
}

/// Historico / logs estruturados por missao.
model MissionEvent {
  id        String   @id @default(uuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type      String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([missionId, createdAt])
  @@map("mission_events")
}

/// Indice recuperavel M1 (MemoryStore persistente).
/// Fonte de verdade continua em Mission / MissionLearning — esta tabela e derivada.
model OperationalMemoryNote {
  id              String    @id @default(uuid())
  workspaceId     String
  content         String
  /// Sempre "operational" em M1.
  layer           String    @default("operational")
  /// operational-run-summary | organizational-learning | operational-digest
  kind            String
  /// mission | learning | digest
  sourceType      String
  /// Id da entidade de origem (missionId / learningId / digest batch id)
  sourceId        String
  /// persistMissionMemory | recordMissionLearning | backfill-mission | backfill-learning
  origin          String
  missionId       String?
  learningId      String?
  statusFinal     String?
  objective       String?
  decision        String?
  resultSummary   String?
  risksJson       Json?
  nextActionsJson Json?
  metadataJson    Json?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  archivedAt      DateTime?

  @@unique([workspaceId, sourceType, sourceId, kind])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@index([workspaceId, expiresAt])
  @@index([missionId])
  @@map("operational_memory_notes")
}

/// Heartbeat + metricas por Employee worker logico.
model WorkerHeartbeat {
  employeeId       String   @id
  status           String
  currentMissionId String?
  metricsJson      Json?
  startedAt        DateTime
  lastSeenAt       DateTime
  updatedAt        DateTime @updatedAt

  @@map("worker_heartbeats")
}

/// Regras de verificacao recorrente (scheduler).
model ScheduleRule {
  id              String    @id @default(uuid())
  workspaceId     String?
  intervalSec     Int
  enabled         Boolean   @default(true)
  lastEnqueuedAt  DateTime?
  configJson      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
  @@map("schedule_rules")
}

enum ApprovalStatus {
  DRAFT
  PROPOSED
  WAITING_APPROVAL
  APPROVED
  REJECTED
  IMPLEMENTING
  COMPLETED
}

/// Lifecycle Domain Signal (ADR-009 / S1).
enum DomainSignalStatus {
  DETECTED
  EVALUATED
  CONVERTED
  RESOLVED
  IGNORED
  EXPIRED
}

/// Decisao de avaliacao auditavel. CONVERT_CANDIDATE nao enfileira Mission em S1.
enum DomainSignalEvaluationDecision {
  CONVERT_CANDIDATE
  IGNORE
  DEFER
}

/// Mapa origem externa → workspace (kill-switch + isolamento).
model WorkspaceSourceBinding {
  id          String   @id @default(uuid())
  workspaceId String
  /// github | n8n | http | internal | …
  sourceType  String
  /// ex.: owner/repo, workflowId
  externalRef String
  enabled     Boolean  @default(true)
  /// filtros (branches, labels) — sem secrets em claro
  configJson  Json?
  /// ponteiro a secret store (nunca o secret)
  secretRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals DomainSignal[]

  @@unique([workspaceId, sourceType, externalRef])
  @@index([sourceType, externalRef, enabled])
  @@map("workspace_source_bindings")
}

/// Ledger de ingress — Signal informa; Opera decide; Mission executa (ADR-009).
model DomainSignal {
  id          String  @id @default(uuid())
  workspaceId String
  bindingId   String?
  binding     WorkspaceSourceBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  /// Familia da origem (ADR source)
  sourceType String
  /// Id no sistema externo (ADR externalId)
  sourceId   String?
  /// Tipo tipado do evento — ex.: github.pr.opened
  type       String

  /// Idempotencia de entrega (unica unique de dedupe)
  deliveryId String
  /// Similaridade / agrupamento — NAO unique
  signalHash String

  /// Trace Signal → Evaluation → Mission → Learning
  correlationId String

  status DomainSignalStatus @default(DETECTED)

  /// Payload ja redigido
  payloadJson  Json
  metadataJson Json?

  evaluationDecision DomainSignalEvaluationDecision?
  /// nome/versao da politica (ex.: default-allowlist@1)
  evaluationPolicy   String?
  /// motivo estavel (ex.: policy_deny, unbound_source, ok)
  evaluationReason   String?
  /// detalhes estruturados da avaliacao
  evaluationJson     Json?
  evaluatedAt        DateTime?

  /// preenchido so em CONVERTED+ (S1: sem enqueue automatico)
  missionId String?

  payloadVersion Int @default(1)

  occurredAt  DateTime?
  receivedAt  DateTime  @default(now())
  convertedAt DateTime?
  resolvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sourceType, deliveryId])
  @@index([workspaceId, status, receivedAt])
  @@index([workspaceId, signalHash, receivedAt])
  @@index([correlationId])
  @@index([missionId])
  @@index([type, receivedAt])
  @@index([evaluationDecision, status])
  @@map("domain_signals")
}

/// Snapshot operacional de repositorio GitHub por workspace (scan do Supervisor).
model WorkspaceGithubSnapshot {
  id                     String   @id @default(uuid())
  workspaceId            String
  bindingId              String?
  repository             String
  defaultBranch          String
  lastCommitSha          String?
  primaryLanguage        String?
  openIssuesCount        Int      @default(0)
  openPullRequestsCount  Int      @default(0)
  /// updated_at / pushed_at remoto do GitHub
  remoteUpdatedAt        DateTime?
  scannedAt              DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([workspaceId, repository])
  @@index([workspaceId, scannedAt])
  @@map("workspace_github_snapshots")
}

/// Latch edge-triggered do Supervisor: workspaceId+reason → no maximo 1 COORDINATE
/// enquanto o sinal operacional persistir (sobrevive restart / multi-instancia).
/// PENDING = borda adquirida (missao ainda nao confirmada); CONSUMED = entregue.
enum CoordinationLatchStatus {
  PENDING
  CONSUMED
}

model CoordinationSignalLatch {
  id            String                   @id @default(uuid())
  workspaceId   String
  /// CoordinationReason estavel (ex.: backlog, recuperacao).
  reason        String
  status        CoordinationLatchStatus  @default(PENDING)
  latchedAt     DateTime                 @default(now())
  lastMissionId String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([workspaceId, reason])
  @@index([workspaceId])
  @@index([status])
  @@map("coordination_signal_latches")
}

/// Auditoria de acoes controladas (Action Runtime A.4).
enum ActionExecutionStatus {
  REQUESTED
  APPROVED
  RUNNING
  SUCCESS
  FAILED
  DENIED
}

model ActionExecution {
  id          String                @id @default(uuid())
  workspaceId String
  employeeId  String
  actionId    String
  target      String                @default("")
  status      ActionExecutionStatus @default(REQUESTED)
  requestedAt DateTime              @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  result      Json?
  error       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([workspaceId, requestedAt])
  @@index([employeeId, requestedAt])
  @@index([actionId, status])
  @@map("action_executions")
}

/// Propostas estruturais — aprovacao humana obrigatoria (sem apply automatico).
model ChangeProposal {
  id                   String         @id @default(uuid())
  projectId            String?
  title                String
  description          String
  justification        String
  evidenceJson         Json?
  expectedImpact       String
  affectedComponents   Json
  risksJson            Json?
  implementationPlan   String
  rollbackPlan         String
  diffRef              String?
  approvalStatus       ApprovalStatus @default(PROPOSED)
  approvedBy           String?
  approvedAt           DateTime?
  rejectedBy           String?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([approvalStatus, createdAt])
  @@index([projectId])
  @@map("change_proposals")
}

/// Decision Ledger append-only do Work Governance Gate (AlreadyDoneGate).
/// Nao editar linhas historicas — so INSERT.
model WorkGovernanceDecision {
  id                 String   @id @default(uuid())
  /// Idempotencia por request (multiplos NULL permitidos no Postgres).
  correlationId      String?  @unique
  workspaceId        String
  /// assisted | signal | supervisor
  source             String
  workIdentity       String
  contextFingerprint String?
  /// SKIP | REUSE | REOPEN | EXECUTE
  decision           String
  reason             String
  authority          String   @default("AlreadyDoneGate")
  resultingMissionId String?
  evidencesJson      Json?
  forceExecute       Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([workspaceId, workIdentity, createdAt])
  @@index([createdAt])
  @@map("work_governance_decisions")
}

// --- Automation Office (P0.3C) — camada de intencao/coordenacao UX ---

enum OfficeDemandStatus {
  DRAFT
  INTERPRETING
  PLANNED
  AWAITING_APPROVAL
  READY
  EXECUTING
  VALIDATING
  COMPLETED
  PAUSED
  FAILED
  CANCELLED
}

enum OfficeRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OfficeAutonomyLevel {
  READ_PLAN
  CONTROLLED
  AUTONOMOUS
  HUMAN_APPROVAL
}

enum OfficePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OfficeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
  EXPIRED
  CANCELLED
}

enum OfficeConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum OfficeAutomationStatus {
  DRAFT
  PLANNED
  READY
  RUNNING
  PAUSED
  FAILED
  VALIDATING
  ACTIVE
  ARCHIVED
}

/// Intencao operacional da usuaria — distinta de Mission (execucao Core).
model OfficeDemand {
  id              String             @id @default(uuid())
  workspaceId     String
  status          OfficeDemandStatus @default(DRAFT)
  objective       String
  context         String             @default("")
  expectedOutcome String             @default("")
  constraintsJson Json               @default("[]")
  priority        OfficePriority     @default(MEDIUM)
  risk            OfficeRiskLevel    @default(MEDIUM)
  autonomy        OfficeAutonomyLevel @default(CONTROLLED)
  planJson        Json?
  missionId       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  resolvedAt      DateTime?

  approvals OfficeApprovalRequest[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("office_demands")
}

/// Gate operacional humano — distinto de ChangeProposal (estrutural).
model OfficeApprovalRequest {
  id             String               @id @default(uuid())
  workspaceId    String
  demandId       String?
  demand         OfficeDemand?        @relation(fields: [demandId], references: [id], onDelete: SetNull)
  action         String
  risk           OfficeRiskLevel      @default(MEDIUM)
  impact         String
  reason         String
  validatedJson  Json                 @default("[]")
  approveEffect  String
  rejectEffect   String
  officeDecision String               @default("")
  status         OfficeApprovalStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([workspaceId, status])
  @@index([demandId])
  @@map("office_approval_requests")
}

/// Auditoria operacional UX — sem chain-of-thought nem prompts internos.
model OfficeDecisionTrace {
  id                    String                @id @default(uuid())
  workspaceId           String
  missionId             String?
  objective             String
  context               String
  optionsJson           Json
  chosenOptionId        String
  rationale             String
  risk                  OfficeRiskLevel       @default(MEDIUM)
  confidence            OfficeConfidenceLevel @default(MEDIUM)
  autonomy              OfficeAutonomyLevel   @default(CONTROLLED)
  impact                String
  nextAction            String
  responsibleEmployeeId String                @default("opera")
  createdAt             DateTime              @default(now())

  @@index([workspaceId, createdAt])
  @@index([missionId])
  @@map("office_decision_traces")
}

/// Definicao de automacao v1 (read-heavy) — execucao via Mission Core.
model OfficeAutomation {
  id                     String                 @id @default(uuid())
  workspaceId            String
  name                   String
  objective              String
  triggerType            String
  triggerConfigJson      Json                   @default("{}")
  actionsJson            Json                   @default("[]")
  autonomy               OfficeAutonomyLevel    @default(CONTROLLED)
  risk                   OfficeRiskLevel        @default(MEDIUM)
  status                 OfficeAutomationStatus @default(DRAFT)
  lastExecutionMissionId String?
  lastExecutionAt        DateTime?
  nextExecutionAt        DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([workspaceId, status])
  @@map("office_automations")
}
