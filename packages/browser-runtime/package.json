{
  "name": "@operaia/browser-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacidade oficial de browser/E2E (Playwright) da OperaIA.lab — READ navigation/screenshot.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headless": "playwright test --grep @headless",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:manual": "OPERAIA_BROWSER_MANUAL=1 playwright test --grep @manual --headed --project=desktop-chromium",
    "e2e:office": "playwright test --grep @office",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
